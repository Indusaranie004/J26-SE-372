# Copy to .env (never commit .env)

# --- Component A ---
COMPONENT_A_MOCK=true
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Component B (reads Component A's Neo4j read-only + A's API) ---
COMPONENT_A_API_URL=http://localhost:8000
COLLECTION_BGEM3_FINETUNED=legal_bge_m3_finetuned
COLLECTION_ANGLEBERT_FINETUNED=legal_anglebert_finetuned

# --- Component C ---
COMPONENT_B_API_URL=http://localhost:8001

# --- Component D ---
COMPONENT_D_API_URL=http://localhost:8003